# Database. Use the Supabase *connection pooler* string on Render.
# Transaction pooler (port 6543) for the app, session pooler (port 5432) for migrations.
# Plain postgresql:// URLs are accepted; the asyncpg driver is added automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsgen

# Secret the GitHub Actions workflow sends in the X-API-Key header to POST /jobs/run
API_KEY=change-me

# External services (used in later steps)
GNEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# kbNews backend and the verified bot account used to post
KBNEWS_BASE_URL=https://kbnews.onrender.com
KBNEWS_BOT_EMAIL=
KBNEWS_BOT_PASSWORD=
